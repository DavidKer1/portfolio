---
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { catalogos, type Giro } from "../catalogos";
import { copy, correo, type Lang } from "../i18n";
import "../styles/global.css";

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	otherPath?: string;
	jsonLd?: boolean;
	// En la página de un catálogo, su giro: le da su color y la forma del vidrio.
	giro?: Giro;
}

const { lang, title, description, otherPath, jsonLd = false, giro } = Astro.props;
const tono = giro ? catalogos[giro].tono : undefined;
const t = copy(lang);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = new URL(otherPath ?? t.routes.other, Astro.site);
const es = lang === "es" ? canonical : other;
const en = lang === "en" ? canonical : other;
const og = new URL("/og.png", Astro.site);
const persona = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Victor Sanchez",
	url: "https://victorsanchez.mx",
	email: correo,
	jobTitle: t.meta.title.split(", ")[1],
	address: {
		"@type": "PostalAddress",
		addressLocality: "Saltillo",
		addressRegion: "Coahuila",
		addressCountry: "MX",
	},
	sameAs: [
		"https://linkedin.com/in/victor-sanchez-dev",
		"https://github.com/DavidKer1",
	],
};
---

<!doctype html>
<html lang={lang === "es" ? "es-MX" : "en"} data-giro={giro} style={tono && `--tono-a: ${tono[0]}; --tono-b: ${tono[1]}`}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content={tono?.[0] ?? "#14c8f5"} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es-MX" href={es} />
		<link rel="alternate" hreflang="en" href={en} />
		<link rel="alternate" hreflang="x-default" href={es} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={og} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />
		<meta name="twitter:card" content="summary_large_image" />
		<Font cssVariable="--font-figtree" preload />
		<script is:inline>
			document.documentElement.classList.add("js");
			if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
				document.documentElement.classList.add("anim");
				setTimeout(() => document.documentElement.classList.remove("anim"), 3000);
			}
		</script>
		{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(persona)} />}
	</head>
	<body>
		<a class="skip" href="#contenido">{t.nav.skip}</a>
		<Header lang={lang} otherPath={otherPath} />
		<main id="contenido">
			<slot />
		</main>
		<Footer lang={lang} />
		<script>
			import "../scripts/site";
			import "../scripts/motion";
		</script>
	</body>
</html>
