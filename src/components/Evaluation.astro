---
import { copy, type Lang } from "../i18n";
import ScoreTable from "./ScoreTable.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const all = copy(lang);
const t = all.evaluation;
---

<section class="band" id={t.id}>
	<div class="section wrap">
		<div class="section-head">
			<h2>{t.h2}</h2>
			<div>
				{t.intro.map((p) => <p>{p}</p>)}
			</div>
		</div>
		<div class="eval-grid">
			<div>
				<ScoreTable lang={lang} />
				<a class="text-link" href={all.routes.folio}>{t.cta}</a>
				<div class="eval-notes eval-below">
					<h3>{t.stillTitle}</h3>
					<ul class="plain-list">
						{t.still.map((s) => <li>{s}</li>)}
					</ul>
					<h3>{t.limitsTitle}</h3>
					<p>{t.limits}</p>
				</div>
			</div>
			<div class="eval-notes">
				<h3>{t.failuresTitle}</h3>
				<ul class="failures">
					{t.failures.map((f) => (
						<li>
							<code lang="es">{f.quote}</code>
							<p>{f.result}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</section>
