---
import { giros } from "../catalogos";
import { copy, correo, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang);
const home = t.routes.home;
const secciones = [
	{ label: t.nav.services, href: `${home}#${t.services.id}` },
	{ label: t.nav.work, href: `${home}#${t.work.id}` },
	{ label: t.nav.process, href: `${home}#${t.process.id}` },
	{ label: t.nav.about, href: `${home}#${t.about.id}` },
];
const ejemplos = giros.map((g) => ({ label: t[g].nav, href: t[g].path }));
const contacto = [
	{ label: correo, href: `mailto:${correo}` },
	{ label: "LinkedIn", href: "https://linkedin.com/in/victor-sanchez-dev" },
	{ label: "GitHub", href: "https://github.com/DavidKer1" },
	{ label: t.nav.other, href: t.routes.other },
];
---

<footer class="site-footer">
	<div class="wrap">
		<div class="footer-cols">
			<ul>
				{secciones.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
			</ul>
			<ul>
				{ejemplos.map((e) => <li><a href={e.href}>{e.label}</a></li>)}
			</ul>
			<ul>
				{contacto.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
			</ul>
		</div>
		<div class="footer-bottom">
			<p class="footer-logo" aria-hidden="true">{"VICTOR".split("").map((l) => <span>{l}</span>)}</p>
			<p class="footer-note">© 2026 {t.footer.rights}</p>
		</div>
	</div>
</footer>
