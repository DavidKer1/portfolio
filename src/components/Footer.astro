---
import { copy, correo, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang);
---

<footer class="site-footer wrap">
	<div class="footer-links">
		<a href={`mailto:${correo}`}>{correo}</a>
		<a href="https://linkedin.com/in/victor-sanchez-dev">LinkedIn</a>
		<a href="https://github.com/DavidKer1">GitHub</a>
	</div>
	<p>{t.footer.colophon}</p>
	<p>Victor Sanchez. {t.footer.location}.</p>
</footer>
