---
import { Image } from "astro:assets";
import movil from "../assets/work/apuntafy-movil.webp";
import producto from "../assets/work/apuntafy-producto.webp";
import { copy, type Lang } from "../i18n";
import CaseLayout from "./CaseLayout.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang).apuntafyCase;
const otherPath = lang === "es" ? "/en/work/apuntafy/" : "/trabajo/apuntafy/";
---

<CaseLayout
	lang={lang}
	title={t.title}
	metaTitle={t.meta}
	description={t.description}
	lead={t.lead}
	facts={t.facts}
	otherPath={otherPath}
>
	<section class="wrap">
		<figure class="panel panel-apuntafy case-shot">
			<Image src={producto} alt={t.altProduct} widths={[640, 1000, 1400]} sizes="(min-width: 1500px) 1388px, 92vw" priority />
		</figure>
	</section>

	<section class="case-section wrap case-two">
		<h2>{t.problemTitle}</h2>
		<p class="case-big">{t.problem}</p>
	</section>

	<section class="case-section wrap">
		<h2>{t.builtTitle}</h2>
		<dl class="built">
			{t.built.map(([name, text]) => (
				<div>
					<dt>{name}</dt>
					<dd>{text}</dd>
				</div>
			))}
		</dl>
	</section>

	<section class="band">
		<div class="case-section wrap case-two">
			<div>
				<h2>{t.detailTitle}</h2>
				<p>{t.detail}</p>
				<p class="fine">{t.base}</p>
				<a class="text-link" href="https://apuntafy.com/es">{t.visit}</a>
			</div>
			<div class="panel panel-apuntafy case-phone">
				<Image src={movil} alt={t.altMobile} widths={[300, 600]} sizes="300px" loading="lazy" />
			</div>
		</div>
	</section>
</CaseLayout>
