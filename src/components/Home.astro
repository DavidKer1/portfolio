---
import { Image } from "astro:assets";
import apuntafy from "../assets/work/apuntafy-producto.webp";
import peoplecor from "../assets/work/peoplecor.webp";
import scholastico from "../assets/work/scholastico.webp";
import sonrisas from "../assets/work/sonrisas.webp";
import tintely1 from "../assets/work/tintely-1.jpg";
import tintely2 from "../assets/work/tintely-2.jpg";
import zenlift from "../assets/work/zenlift.webp";
import { copy, correo, type Lang, telefono, whatsapp } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang);
const d = t.diagram;
const imagenes: Record<string, ImageMetadata> = { sonrisas, peoplecor, scholastico, apuntafy, zenlift };
const proyecto = (id: string) => {
	const p = t.work.items.find((i) => i.id === id);
	if (!p) throw new Error(`Falta el proyecto ${id}`);
	return p;
};
const filas = [["sonrisas"], ["peoplecor", "scholastico"], ["apuntafy"], ["tintely", "zenlift"]];
const flecha = `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`;
---

<Base lang={lang} jsonLd>
	<section class="hero">
		<div class="wrap">
			<div class="hero-top">
				<p class="mono"><span class="dot" aria-hidden="true"></span>{t.hero.name}</p>
				<p class="mono hero-role">{t.hero.role}</p>
			</div>
			<h1>
				<span>{t.hero.h1a}</span>
				<span class="grad">{t.hero.h1b}</span>
			</h1>
			<div class="hero-grid">
				<div>
					<p class="hero-lead">{t.hero.lead}</p>
					<div class="hero-actions">
						<a class="btn btn-accent" href={`#${t.work.id}`}>
							{t.hero.cta}
							<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
						</a>
						<span class="btn btn-ghost mail-box">
							<a href={`mailto:${correo}`}>{correo}</a>
							<button type="button" class="copy mono" data-copy={correo} data-copied={t.hero.copied} aria-live="polite">{t.hero.copy}</button>
						</span>
					</div>
				</div>
				<form class="chat" data-chat data-default={t.whatsapp} action={`https://wa.me/${telefono}`} method="get" target="_blank">
					<div class="chat-head">
						<span class="chat-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2.2A9.8 9.8 0 0 0 3.6 17l-1.4 5 5.1-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.9a8.1 8.1 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.1 8.1 0 1 1 12 20.1Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"></path></svg>
						</span>
						<div>
							<p class="chat-title">{t.chat.title}</p>
							<p class="chat-sub">{t.chat.subtitle}</p>
						</div>
					</div>
					<div class="chat-input">
						<label class="sr-only" for="chat-texto">{t.chat.label}</label>
						<input id="chat-texto" name="text" type="text" placeholder={t.chat.placeholder} autocomplete="off" />
						<button type="submit" aria-label={t.chat.send}>
							<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
						</button>
					</div>
					<div class="chat-chips">
						{t.chat.chips.map((c) => <button type="button" class="chip" data-chip={c}>{c}</button>)}
					</div>
				</form>
			</div>
		</div>
	</section>

	<section class="wrap process" aria-label={lang === "es" ? "Cómo trabajo" : "How I work"}>
		<ol class="process-grid">
			<li>
				<div class="process-art" aria-hidden="true">
					<svg viewBox="0 0 160 100">
						<rect class="ln" x="22" y="14" width="116" height="72" rx="4" />
						<line class="ln" x1="22" y1="26" x2="138" y2="26" />
						<line class="ln" x1="30" y1="36" x2="44" y2="36" /><line class="ln" x1="30" y1="44" x2="40" y2="44" /><line class="ln" x1="30" y1="52" x2="44" y2="52" />
						<rect class="ac" x="56" y="33" width="68" height="20" rx="2" />
						<line class="ac" x1="64" y1="43" x2="108" y2="43" />
						<rect class="ln" x="56" y="62" width="30" height="14" rx="2" /><rect class="ln" x="94" y="62" width="30" height="14" rx="2" />
					</svg>
				</div>
				<h2>{t.process[0].name}</h2>
				<p>{t.process[0].text}</p>
			</li>
			<li>
				<div class="process-art" aria-hidden="true">
					<svg viewBox="0 0 160 100">
						<rect class="ac fill" x="14" y="22" width="44" height="22" rx="3" /><text x="36" y="37" text-anchor="middle">{d.app}</text>
						<line class="ac" x1="58" y1="33" x2="96" y2="33" /><path class="ac" d="M91 29 96 33 91 37" />
						<rect class="ln" x="98" y="22" width="44" height="22" rx="3" /><text x="120" y="37" text-anchor="middle">{d.api}</text>
						<line class="ln" x1="120" y1="44" x2="120" y2="58" /><path class="ln" d="M116 54 120 58 124 54" />
						<rect class="ln" x="98" y="60" width="44" height="22" rx="3" /><text x="120" y="75" text-anchor="middle">{d.data}</text>
						<path class="ln" d="M28 64 20 71 28 78M50 64 58 71 50 78M42 62 36 80" />
					</svg>
				</div>
				<h2>{t.process[1].name}</h2>
				<p>{t.process[1].text}</p>
			</li>
			<li>
				<div class="process-art" aria-hidden="true">
					<svg viewBox="0 0 160 100">
						<line class="ln" x1="34" y1="42" x2="126" y2="42" />
						<circle class="ln dark" cx="34" cy="42" r="12" /><path class="ln" d="M28 42 32 46 40 38" />
						<circle class="ln dark" cx="80" cy="42" r="12" /><path class="ln" d="M74 42 78 46 86 38" />
						<circle class="ac fill" cx="126" cy="42" r="14" /><path class="ac" d="M126 49V35M120 41l6-6 6 6" />
						<text x="34" y="76" text-anchor="middle">{d.tests}</text><text x="80" y="76" text-anchor="middle">{d.review}</text><text x="126" y="76" text-anchor="middle">{d.live}</text>
					</svg>
				</div>
				<h2>{t.process[2].name}</h2>
				<p>{t.process[2].text}</p>
			</li>
			<li>
				<div class="process-art" aria-hidden="true">
					<svg viewBox="0 0 160 100">
						<rect class="ln" x="22" y="14" width="116" height="72" rx="4" />
						<line class="ln" x1="22" y1="30" x2="138" y2="30" />
						<text x="30" y="25" text-anchor="start">{d.monitor}</text>
						<circle class="ac" cx="128" cy="22" r="5" /><path class="ac" d="M125.5 22 127.5 24 131 20" />
						<path class="ac" d="M30 62H52L60 48 70 74 78 56H92L100 60H130" />
						<line class="ln dim" x1="30" y1="70" x2="130" y2="70" />
					</svg>
				</div>
				<h2>{t.process[3].name}</h2>
				<p>{t.process[3].text}</p>
			</li>
		</ol>
	</section>

	<section class="wrap work" id={t.work.id}>
		<p class="eyebrow">{t.work.eyebrow}</p>
		<h2 class="section-title">{t.work.h2}</h2>
		<div class="cards">
			{filas.map((fila) => (
				<div class:list={["card-row", { "card-row-wide": fila.length === 1 }]}>
					{fila.map((id) => {
						const p = proyecto(id);
						const ancho = fila.length === 1;
						return (
							<article class:list={["card", `card-${id}`, { "card-wide": ancho }]}>
								<div class="card-media">
									{id === "tintely" ? (
										<div class="tintely-pair">
											<Image src={tintely1} alt={p.alt} widths={[300, 600]} sizes="(min-width: 900px) 18vw, 40vw" loading="lazy" />
											<Image src={tintely2} alt="" widths={[300, 600]} sizes="(min-width: 900px) 18vw, 40vw" loading="lazy" />
										</div>
									) : (
										<Image src={imagenes[id]} alt={p.alt} widths={[480, 800, 1200]} sizes={ancho ? "(min-width: 900px) 56vw, 100vw" : "(min-width: 900px) 44vw, 100vw"} loading="lazy" />
									)}
								</div>
								<div class="card-body">
									<p class="mono card-tags">{p.tags}</p>
									<div class="card-title">
										<h3>{p.name}</h3>
										<a class="circle-link" href={p.href} aria-label={`${t.work.open} ${p.name}`} set:html={flecha} />
									</div>
									<p class="card-text">{p.text}</p>
									<ul class="stack-chips">
										{p.stack.map((s) => <li>{s}</li>)}
									</ul>
								</div>
							</article>
						);
					})}
				</div>
			))}
		</div>

		<p class="eyebrow eyebrow-plain">{t.work.moreTitle}</p>
		<ul class="more">
			{t.work.more.map((m) => (
				<li>
					<div>
						<p class="more-name">{m.name}</p>
						<p class="more-stack">{m.stack}</p>
					</div>
					<p class="more-kind">{m.kind}</p>
				</li>
			))}
		</ul>
	</section>

	<section class="about-band" id={t.about.id}>
		<div class="wrap about">
			<div>
				<p class="eyebrow">{t.about.eyebrow}</p>
				<h2 class="section-title">
					<span>{t.about.h2a}</span>
					<span class="grad">{t.about.h2b}</span>
				</h2>
			</div>
			<div>
				<p class="about-lead">{t.about.text[0]}</p>
				{t.about.text.slice(1).map((p) => <p class="about-text">{p}</p>)}
				<dl class="stack-table">
					{t.about.stack.map(([k, v]) => (
						<div>
							<dt>{k}</dt>
							<dd>{v}</dd>
						</div>
					))}
				</dl>
			</div>
		</div>
	</section>

	<section class="wrap contact" id={t.contact.id}>
		<div>
			<p class="eyebrow">{t.contact.eyebrow}</p>
			<h2 class="contact-title">
				<span>{t.contact.h2a}</span>
				<span>{t.contact.h2b}<span class="accent">?</span></span>
			</h2>
			<p class="contact-text">{t.contact.text}</p>
			<a class="contact-mail" href={`mailto:${correo}`}>{correo} <span set:html={flecha} /></a>
			<p class="contact-note"><a href={whatsapp(lang)}>{t.contact.whatsapp}</a></p>
		</div>
		<form class="contact-form" data-mail-form data-mailto={correo} data-subject={t.contact.subject}>
			<div class="field-row">
				<label>
					<span>{t.contact.name}</span>
					<input name="nombre" type="text" placeholder={t.contact.namePh} autocomplete="name" required />
				</label>
				<label>
					<span>{t.contact.email}</span>
					<input name="correo" type="email" placeholder={t.contact.emailPh} autocomplete="email" required />
				</label>
			</div>
			<label>
				<span>{t.contact.project} <small>({t.contact.optional})</small></span>
				<input name="proyecto" type="text" placeholder={t.contact.projectPh} />
			</label>
			<label>
				<span>{t.contact.message}</span>
				<textarea name="mensaje" rows="5" placeholder={t.contact.messagePh} required></textarea>
			</label>
			<button type="submit" class="btn btn-accent btn-pill">
				{t.contact.submit}
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
			</button>
			<p class="form-status" role="status" data-mail-status hidden>{t.contact.sent} <a href={`mailto:${correo}`}>{correo}</a></p>
		</form>
	</section>
</Base>
