---
import { Image } from "astro:assets";
import apuntafyCal from "../assets/work/apuntafy-calendario.webp";
import apuntafyMovil from "../assets/work/apuntafy-movil.webp";
import apuntafyProducto from "../assets/work/apuntafy-producto.webp";
import peoplecor from "../assets/work/peoplecor.webp";
import scholastico from "../assets/work/scholastico.webp";
import sonrisas from "../assets/work/sonrisas.webp";
import tintely1 from "../assets/work/tintely-1.jpg";
import tintely2 from "../assets/work/tintely-2.jpg";
import zenlift from "../assets/work/zenlift.webp";
import { copy, correo, type Lang } from "../i18n";
import Base from "../layouts/Base.astro";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang);
const imagenes: Record<string, ImageMetadata> = {
	sonrisas,
	scholastico,
	peoplecor,
	zenlift,
};
const [destacados, resto] = [t.work.items.slice(0, 2), t.work.items.slice(2)];
---

<Base lang={lang} jsonLd>
	<section class="hero wrap">
		<div class="hero-text">
			<h1>{t.hero.h1}</h1>
			<p class="hero-lead">{t.hero.lead}</p>
			<div class="hero-actions">
				<WhatsAppButton lang={lang} label={t.hero.cta} />
				<a class="text-link" href={`#${t.work.id}`}>{t.hero.secondary}</a>
			</div>
			<p class="hero-note">{t.hero.note}</p>
		</div>
		<figure class="hero-shot">
			<a class="panel panel-apuntafy" href={t.routes.apuntafy} tabindex="-1" aria-hidden="true">
				<Image src={apuntafyProducto} alt="" widths={[640, 960, 1400]} sizes="(min-width: 1100px) 50vw, 100vw" priority />
			</a>
			<figcaption>{t.hero.caption}</figcaption>
		</figure>
	</section>

	<section class="proof wrap" aria-label={t.hero.proofLabel}>
		<p>{t.hero.proofLabel}</p>
		<ul>
			{t.hero.proof.map((nombre) => <li>{nombre}</li>)}
		</ul>
	</section>

	<section class="section wrap" id={t.services.id}>
		<h2>{t.services.h2}</h2>
		<ul class="services">
			{t.services.items.map((s) => (
				<li>
					<h3>{s.name}</h3>
					<p>{s.text}</p>
					<a href={s.href}>{s.example}</a>
				</li>
			))}
		</ul>
	</section>

	<section class="band" id={t.featured.id}>
		<div class="section wrap featured">
			<div class="featured-text">
				<h2>{t.featured.h2}</h2>
				<p class="featured-lead">{t.featured.text}</p>
				<ul class="points">
					{t.featured.points.map((p) => <li>{p}</li>)}
				</ul>
				<p class="featured-links">
					<a class="button" href={t.routes.apuntafy}>{t.featured.cta}</a>
					<a class="text-link" href="https://apuntafy.com/es">{t.featured.site}</a>
				</p>
			</div>
			<div class="panel panel-apuntafy featured-shots">
				<Image class="shot-desktop" src={apuntafyCal} alt={t.apuntafyCase.altCalendar} widths={[640, 960, 1400]} sizes="(min-width: 1100px) 46vw, 86vw" loading="lazy" />
				<Image class="shot-phone" src={apuntafyMovil} alt="" widths={[240, 400]} sizes="(min-width: 1100px) 15vw, 30vw" loading="lazy" />
			</div>
		</div>
	</section>

	<section class="section wrap" id={t.work.id}>
		<h2>{t.work.h2}</h2>
		<div class="projects projects-two">
			{destacados.map((p) => (
				<article class="project" id={p.id}>
					{p.id === "tintely" ? (
						<div class="panel panel-tintely">
							<Image src={tintely1} alt={p.alt} widths={[300, 600]} sizes="(min-width: 760px) 22vw, 45vw" loading="lazy" />
							<Image src={tintely2} alt="" widths={[300, 600]} sizes="(min-width: 760px) 22vw, 45vw" loading="lazy" />
						</div>
					) : (
						<div class="panel panel-photo">
							<Image src={imagenes[p.id]} alt={p.alt} widths={[480, 800, 1200]} sizes="(min-width: 760px) 46vw, 100vw" loading="lazy" />
						</div>
					)}
					<h3>{p.name}</h3>
					<p>{p.text}</p>
					<p class="project-meta">{p.kind}. <a href={p.href}>{p.link}</a></p>
				</article>
			))}
		</div>
		<div class="projects projects-three">
			{resto.map((p) => (
				<article class="project" id={p.id}>
					<div class="panel panel-photo">
						<Image src={imagenes[p.id]} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 760px) 30vw, 100vw" loading="lazy" />
					</div>
					<h3>{p.name}</h3>
					<p>{p.text}</p>
					<p class="project-meta">{p.kind}. <a href={p.href}>{p.link}</a></p>
				</article>
			))}
		</div>
	</section>

	<section class="band" id={t.process.id}>
		<div class="section wrap">
			<h2>{t.process.h2}</h2>
			<ol class="steps">
				{t.process.steps.map((s) => (
					<li>
						<h3>{s.name}</h3>
						<p>{s.text}</p>
					</li>
				))}
			</ol>
			<p class="steps-note">{t.process.note}</p>
		</div>
	</section>

	<section class="section wrap faq-about">
		<div>
			<h2>{t.faq.h2}</h2>
			<dl class="faq">
				{t.faq.items.map((f) => (
					<div>
						<dt>{f.q}</dt>
						<dd>{f.a}</dd>
					</div>
				))}
			</dl>
		</div>
		<div class="about">
			<h2>{t.about.h2}</h2>
			<p>{t.about.text}</p>
			<p class="about-stack">{t.about.stack}</p>
		</div>
	</section>

	<section class="contact" id={t.contact.id}>
		<div class="wrap contact-inner">
			<h2>{t.contact.h2}</h2>
			<p>{t.contact.text}</p>
			<div class="contact-actions">
				<WhatsAppButton lang={lang} label={t.contact.whatsapp} dark />
				<p class="contact-mail">
					<a href={`mailto:${correo}`}>{correo}</a>
					<button type="button" class="copy" data-copy={correo} data-copied={t.contact.copied} aria-live="polite">{t.contact.copy}</button>
				</p>
			</div>
		</div>
	</section>
</Base>
