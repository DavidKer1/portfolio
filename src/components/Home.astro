---
import { Image } from "astro:assets";
import apuntafy from "../assets/work/apuntafy-producto.webp";
import apuntafyMovil from "../assets/work/apuntafy-movil.webp";
import peoplecor from "../assets/work/peoplecor.webp";
import scholastico from "../assets/work/scholastico.webp";
import sonrisas from "../assets/work/sonrisas.webp";
import tintely1 from "../assets/work/tintely-1.jpg";
import tintely2 from "../assets/work/tintely-2.jpg";
import zenlift from "../assets/work/zenlift.webp";
import { copy, correo, type Lang, whatsapp } from "../i18n";
import Base from "../layouts/Base.astro";
import WaIcon from "./WaIcon.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang);
const imagenes: Record<string, ImageMetadata> = {
	apuntafy,
	apuntafyMovil,
	peoplecor,
	scholastico,
	sonrisas,
	tintely1,
	tintely2,
	zenlift,
};
const flecha = `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>`;
---

<Base lang={lang} jsonLd>
	<section class="hero">
		<div class="hero-glass" aria-hidden="true"></div>
		<div class="floats" aria-hidden="true">
			<div class="float f1"><Image src={apuntafy} alt="" widths={[360, 720]} sizes="320px" priority /></div>
			<div class="float f2"><Image src={peoplecor} alt="" widths={[300, 600]} sizes="260px" priority /></div>
			<div class="float f3"><Image src={sonrisas} alt="" widths={[300, 600]} sizes="240px" loading="lazy" /></div>
			<div class="float f4"><Image src={apuntafyMovil} alt="" widths={[240, 480]} sizes="200px" loading="lazy" /></div>
		</div>
		<div class="wrap hero-inner">
			<h1>
				<span>{t.hero.h1a}</span>
				<span>{t.hero.h1b}</span>
			</h1>
			<p class="hero-lead">{t.hero.lead}</p>
			<div class="hero-actions">
				<a class="btn btn-navy" href={whatsapp(lang)}>{t.hero.primary}<WaIcon /></a>
				<a class="btn btn-white" href={`#${t.work.id}`}>{t.hero.secondary}</a>
			</div>
			<p class="hero-mail">
				{t.hero.mail} <a href={`mailto:${correo}`}>{correo}</a>
				<button type="button" class="copy" data-copy={correo} data-copied={t.copied} aria-live="polite">{t.copy}</button>
			</p>
		</div>
	</section>

	<section class="strip" aria-label={t.strip}>
		<p>{t.strip}</p>
		<ul>
			{t.work.items.map((p) => <li>{p.name}</li>)}
		</ul>
	</section>

	<section class="wrap services" id={t.services.id}>
		<div class="heading">
			<p class="pill pill-orange">{t.services.pill}</p>
			<h2 class="two-tone"><span class="c">{t.services.h2a}</span><span>{t.services.h2b}</span></h2>
		</div>
		<div class="tabs" role="tablist" hidden data-tabs>
			{t.services.items.map((s, i) => (
				<button
					type="button"
					role="tab"
					id={`tab-${i}`}
					aria-controls={`panel-${i}`}
					aria-selected={i === 0 ? "true" : "false"}
					tabindex={i === 0 ? 0 : -1}
				>
					{s.tab}
				</button>
			))}
		</div>
		<div class="panels">
			{t.services.items.map((s, i) => (
				<div class:list={["service-card", { "is-active": i === 0 }]} role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`}>
					<div class="service-text">
						<h3>{s.title}</h3>
						<p>{s.text}</p>
						<p class="service-examples"><strong>{t.services.examples}:</strong> {s.examples}</p>
						<a class="btn btn-white" href={whatsapp(lang)}>{t.services.cta}</a>
					</div>
					<div class={`tiles tiles-${s.images.length}`}>
						{s.images.map((k) => (
							<div class={`tile tile-${k}`}>
								<Image src={imagenes[k]} alt="" widths={[320, 640]} sizes="(min-width: 900px) 22vw, 45vw" loading="lazy" />
							</div>
						))}
					</div>
				</div>
			))}
		</div>
	</section>

	<section class="band-navy" id={t.work.id}>
		<div class="wrap">
			<div class="heading">
				<p class="pill pill-yellow">{t.work.pill}</p>
				<h2 class="two-tone on-navy"><span class="c">{t.work.h2a}</span><span>{t.work.h2b}</span></h2>
			</div>
			<div class="project-grid">
				{t.work.items.map((p) => (
					<article class="project-card">
						<div class={`project-media media-${p.id}`}>
							{p.id === "tintely" ? (
								<div class="tintely-pair">
									<Image src={tintely1} alt={p.alt} widths={[280, 560]} sizes="(min-width: 900px) 14vw, 40vw" loading="lazy" />
									<Image src={tintely2} alt="" widths={[280, 560]} sizes="(min-width: 900px) 14vw, 40vw" loading="lazy" />
								</div>
							) : (
								<Image src={imagenes[p.id]} alt={p.alt} widths={[400, 800, 1200]} sizes="(min-width: 900px) 30vw, 100vw" loading="lazy" />
							)}
						</div>
						<div class="project-body">
							<p class="project-kind">{p.kind}</p>
							<h3>{p.name}</h3>
							<p>{p.text}</p>
							<a class="project-link" href={p.href}>{t.work.open} {p.name} <span set:html={flecha} /></a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="wrap process" id={t.process.id}>
		<div class="heading">
			<p class="pill pill-blue">{t.process.pill}</p>
			<h2 class="two-tone"><span class="c">{t.process.h2a}</span><span>{t.process.h2b}</span></h2>
		</div>
		<ol class="steps">
			{t.process.steps.map((s, i) => (
				<li>
					<span class="step-num" aria-hidden="true">{i + 1}</span>
					<h3>{s.name}</h3>
					<p>{s.text}</p>
				</li>
			))}
		</ol>
	</section>

	<section class="wrap about" id={t.about.id}>
		<div class="about-card">
			<div>
				<p class="pill pill-orange">{t.about.pill}</p>
				<h2 class="two-tone"><span class="c">{t.about.h2a}</span><span>{t.about.h2b}</span></h2>
			</div>
			<div class="about-body">
				{t.about.text.map((p) => <p>{p}</p>)}
				<p class="stack-label">{t.about.stackLabel}</p>
				<ul class="stack">
					{t.about.stack.map((s) => <li>{s}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="cta-band" id={t.contact.id}>
		<div class="wrap cta-inner">
			<p class="pill pill-white">{t.contact.pill}</p>
			<h2><span>{t.contact.h2a}</span><span>{t.contact.h2b}</span></h2>
			<p class="cta-text">{t.contact.text}</p>
			<div class="hero-actions">
				<a class="btn btn-navy" href={whatsapp(lang)}>{t.hero.primary}<WaIcon /></a>
				<span class="mail-chip">
					<a href={`mailto:${correo}`}>{correo}</a>
					<button type="button" class="copy" data-copy={correo} data-copied={t.copied} aria-live="polite">{t.copy}</button>
				</span>
			</div>
			{t.contact.agencies && <p class="cta-agencies">{t.contact.agencies}</p>}
		</div>
	</section>
</Base>
