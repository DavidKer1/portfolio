---
import { Image } from "astro:assets";
import { catalogos, type Giro } from "../catalogos";
import { copy, correo, type Lang, telefono } from "../i18n";
import Base from "../layouts/Base.astro";
import WaIcon from "./WaIcon.astro";

interface Props {
	lang: Lang;
	giro: Giro;
}

const { lang, giro } = Astro.props;
const t = copy(lang);
const r = t[giro];
const c = catalogos[giro];
const demos = c.demos;
const ruta = (id: string) => (lang === "en" && c.rutasEn?.[id]) || id;
const whatsapp = `https://wa.me/${telefono}?text=${encodeURIComponent(r.whatsapp)}`;
const portadas = c.portadas;
const [f1, f2, f3, f4] = c.flotantes.map((id) => portadas[id]);
const flecha = `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>`;
---

<Base lang={lang} title={r.meta.title} description={r.meta.description} otherPath={r.other}>
	<section class="hero">
		<div class="hero-glass-wrap" aria-hidden="true"><div class="hero-glass"></div></div>
		<div class="floats" aria-hidden="true">
			<div class="float-wrap f1" data-speed="-90"><div class="float"><Image src={f1} alt="" widths={[300, 600]} sizes="250px" priority /></div></div>
			<div class="float-wrap f2" data-speed="-60"><div class="float"><Image src={f2} alt="" widths={[300, 600]} sizes="230px" priority /></div></div>
			<div class="float-wrap f3" data-speed="-150"><div class="float"><Image src={f3} alt="" widths={[300, 600]} sizes="220px" loading="lazy" /></div></div>
			<div class="float-wrap f4" data-speed="-190"><div class="float"><Image src={f4} alt="" widths={[240, 480]} sizes="180px" loading="lazy" /></div></div>
		</div>
		<div class="wrap hero-inner">
			<p class="pill pill-white rest-pill">{r.pill}</p>
			<h1>
				<span class="line"><span class="line-in">{r.h1a}</span></span>
				<span class="line"><span class="line-in">{r.h1b}</span></span>
			</h1>
			<p class="hero-lead">{r.lead}</p>
			<div class="hero-actions">
				<a class="btn btn-navy" href={whatsapp}>{r.primary}<WaIcon /></a>
				<a class="btn btn-white" href={`#${r.examplesId}`}>{r.secondary}</a>
			</div>
			<p class="hero-mail rest-nota">{r.note}</p>
		</div>
	</section>

	<section class="band-navy" id={r.examplesId}>
		<div class="wrap">
			<div class="heading" data-heading>
				<p class="pill pill-yellow">{r.examplesPill}</p>
				<h2 class="two-tone on-navy"><span class="line c"><span class="line-in">{r.examplesH2a}</span></span><span class="line"><span class="line-in">{r.examplesH2b}</span></span></h2>
			</div>
			<div class="project-grid">
				{r.items.map((d) => (
					<article class="project-card">
						<div class="project-media media-rest">
							<Image src={portadas[d.id]} alt={d.alt} widths={[400, 800, 1200]} sizes="(min-width: 1000px) 30vw, (min-width: 760px) 45vw, 92vw" loading="lazy" />
						</div>
						<div class="project-body">
							<p class="project-kind">{d.kind}</p>
							<h3>{d.name}</h3>
							<p>{d.text}</p>
							<a class="project-link" href={`${demos}/${ruta(d.id)}/`} target="_blank" rel="noopener">{r.open} <span set:html={flecha} /></a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="wrap process">
		<div class="heading" data-heading>
			<p class="pill pill-blue">{r.includesPill}</p>
			<h2 class="two-tone"><span class="line c"><span class="line-in">{r.includesH2a}</span></span><span class="line"><span class="line-in">{r.includesH2b}</span></span></h2>
		</div>
		<ul class="steps rest-incluye">
			{r.includes.map((s) => (
				<li>
					<h3>{s.name}</h3>
					<p>{s.text}</p>
				</li>
			))}
		</ul>
	</section>

	<section class="cta-band rest-cta">
		<div class="wrap cta-inner" data-heading>
			<h2><span class="line"><span class="line-in">{r.ctaH2a}</span></span><span class="line"><span class="line-in">{r.ctaH2b}</span></span></h2>
			<p class="cta-text">{r.ctaText}</p>
			<div class="hero-actions">
				<a class="btn btn-navy" href={whatsapp}>{r.primary}<WaIcon /></a>
				<span class="mail-chip">
					<a href={`mailto:${correo}`}>{correo}</a>
					<button type="button" class="copy" data-copy={correo} data-copied={t.copied} aria-live="polite">{t.copy}</button>
				</span>
			</div>
		</div>
	</section>
</Base>
