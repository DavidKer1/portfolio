---
import { copy, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang).about;
---

<section class="band">
	<div class="section wrap about">
		<div>
			<h2>{t.h2}</h2>
			{t.agents.map((p) => <p class="about-text">{p}</p>)}
		</div>
		<div>
			<h3>{t.meTitle}</h3>
			<p>{t.me}</p>
			<h3>{t.stackTitle}</h3>
			<p>{t.stack}</p>
		</div>
	</div>
</section>
