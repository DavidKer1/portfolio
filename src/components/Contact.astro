---
import { copy, correo, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const all = copy(lang);
const t = all.contact;
---

<section class="contact" id={t.id}>
	<div class="wrap contact-grid">
		<div>
			<h2>{t.h2}</h2>
			<p>{t.text}</p>
			<p class="contact-direct">
				{t.orWrite}
				<a href={`mailto:${correo}`}>{correo}</a>
				<button type="button" class="copy" data-copy={correo} data-copied={all.hero.copied} aria-live="polite">{all.hero.copy}</button>
			</p>
		</div>
		<form data-mail-form data-mailto={correo}>
			<input type="hidden" name="subject" value={t.subject} />
			<label for="mensaje">{t.label}</label>
			<textarea id="mensaje" name="body" rows="6" placeholder={t.placeholder} required></textarea>
			<button type="submit" class="button button-dark">{t.submit}</button>
			<p class="contact-status" role="status" data-mail-status hidden>{t.fallback} <a href={`mailto:${correo}`}>{correo}</a></p>
		</form>
	</div>
</section>
