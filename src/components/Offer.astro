---
import { copy, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const all = copy(lang);
const t = all.offer;
---

<section class="section wrap offer" id={t.id}>
	<div class="offer-main">
		<h2>{t.h2}</h2>
		<p class="offer-text">{t.text}</p>
		<p class="offer-text">{t.local}</p>
	</div>
	<div class="offer-side">
		<p class="offer-price">{t.price}<span>{t.priceNote}</span></p>
		<a class="button" href={`#${all.contact.id}`}>{all.hero.cta}</a>
		<h3>{t.nextTitle}</h3>
		<dl class="offer-next">
			{t.next.map((n) => (
				<div>
					<dt>{n.name}</dt>
					<dd>{n.text}</dd>
				</div>
			))}
		</dl>
	</div>
	<div class="offer-fit">
		<p><strong>{t.yesTitle}</strong> {t.yes}</p>
		<p><strong>{t.noTitle}</strong> {t.no}</p>
	</div>
</section>
