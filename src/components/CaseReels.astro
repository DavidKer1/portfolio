---
import { copy, type Lang } from "../i18n";
import CaseLayout from "./CaseLayout.astro";
import ReelsRoute from "./ReelsRoute.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang).reelsCase;
const otherPath = lang === "es" ? "/en/work/reels-lab/" : "/trabajo/reels-lab/";

const reparacion = `"Return only corrected JSON matching { title, pacing, assetLabels, scenes }.",
"The previous generation plan failed validation. Do not write TSX or code.",
\`Validation errors: \${JSON.stringify(input.validationErrors)}\`,
\`Rejected plan: \${JSON.stringify(input.rejectedPlan)}\`,
\`Original prompt: \${input.originalPrompt}\``;

const imports = `const allowedImports = new Set(["react", "remotion"]);
const blockedImports = new Set([
  "fs", "node:fs", "child_process", "node:child_process",
  "net", "node:net", "http", "node:http",
  "https", "node:https", "process", "node:process"
]);`;

const respaldo = `try {
  return {
    plan: await aiPlanFn(input.prompt),
    provider: input.aiConfig.provider
  };
} catch {
  return { plan: createLocalPlan(input), provider: "local" };
}`;
---

<CaseLayout
	lang={lang}
	title={t.title}
	metaTitle={t.meta}
	description={t.description}
	lead={t.lead}
	facts={t.facts}
	otherPath={otherPath}
>
	<section class="case-section wrap">
		<h2>{t.routeTitle}</h2>
		<p>{t.routeText}</p>
		<div class="panel panel-diagram case-diagram">
			<ReelsRoute lang={lang} />
		</div>
	</section>

	<section class="case-section wrap case-two">
		<div>
			<h2>{t.noCodeTitle}</h2>
			<p>{t.noCodeText}</p>
		</div>
		<div>
			<div class="case-code-block">
				<p class="case-code-title">aiGeneration.ts</p>
				<pre class="case-code" tabindex="0"><code>{reparacion}</code></pre>
			</div>
			<div class="case-code-block">
				<p class="case-code-title">sandbox.ts</p>
				<pre class="case-code" tabindex="0"><code>{imports}</code></pre>
			</div>
		</div>
	</section>

	<div class="band">
		<section class="case-section wrap case-two">
			<div class="case-prose">
				<h2>{t.failedTitle}</h2>
				{t.failedText.map((p) => <p>{p}</p>)}
			</div>
			<div class="case-code-block">
				<p class="case-code-title">aiGeneration.ts</p>
				<pre class="case-code case-code-dark" tabindex="0"><code>{respaldo}</code></pre>
			</div>
		</section>
	</div>

	<section class="case-section wrap">
		<h2>{t.changeTitle}</h2>
		<p>{t.change}</p>
	</section>
</CaseLayout>
