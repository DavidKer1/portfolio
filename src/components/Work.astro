---
import { Image } from "astro:assets";
import apuntafyCal from "../assets/work/apuntafy-calendario.webp";
import apuntafyMovil from "../assets/work/apuntafy-movil.webp";
import folioImg from "../assets/work/folio-pedido.png";
import tintely1 from "../assets/work/tintely-1.jpg";
import tintely2 from "../assets/work/tintely-2.jpg";
import zenlift1 from "../assets/work/zenlift-inicio.png";
import zenlift2 from "../assets/work/zenlift-entrenamiento.png";
import zenlift3 from "../assets/work/zenlift-historial.png";
import { copy, type Lang } from "../i18n";
import ReelsRoute from "./ReelsRoute.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const all = copy(lang);
const t = all.work;
const i = t.items;
---

<section class="section wrap" id={t.id}>
	<h2 class="work-title">{t.h2}</h2>

	<h3 class="work-group">{t.groups.model}</h3>

	<article class="project project-wide">
		<a class="panel panel-folio" href={all.routes.folio} tabindex="-1" aria-hidden="true">
			<Image src={folioImg} alt="" widths={[640, 960, 1400, 2000]} sizes="(min-width: 1100px) 62vw, 100vw" loading="lazy" />
		</a>
		<div class="project-text">
			<h4>{i.folio.name}</h4>
			<p>{i.folio.text}</p>
			<p class="project-status">{i.folio.status}</p>
			<p class="project-stack">{i.folio.stack}</p>
			<a class="text-link" href={all.routes.folio}>{t.viewCase}<span class="sr-only">: {i.folio.name}</span></a>
		</div>
	</article>

	<article class="project project-wide project-flip">
		<div class="panel panel-diagram">
			<ReelsRoute lang={lang} />
		</div>
		<div class="project-text">
			<h4>{i.reels.name}</h4>
			<p>{i.reels.text}</p>
			<p class="project-status">{i.reels.status}</p>
			<p class="project-stack">{i.reels.stack}</p>
			<a class="text-link" href={all.routes.reels}>{t.viewCase}<span class="sr-only">: {i.reels.name}</span></a>
		</div>
	</article>

	<h3 class="work-group">{t.groups.other}</h3>

	<article class="project project-wide">
		<div class="panel panel-apuntafy">
			<Image class="shot-desktop" src={apuntafyCal} alt={i.apuntafy.alt} widths={[640, 960, 1400]} sizes="(min-width: 1100px) 52vw, 86vw" loading="lazy" />
			<Image class="shot-phone" src={apuntafyMovil} alt="" widths={[240, 400]} sizes="(min-width: 1100px) 18vw, 30vw" loading="lazy" />
		</div>
		<div class="project-text">
			<h4>{i.apuntafy.name}</h4>
			<p>{i.apuntafy.text}</p>
			<p class="project-status">{i.apuntafy.status}</p>
			<p class="project-stack">{i.apuntafy.stack}</p>
			<a class="text-link" href={all.routes.apuntafy}>{t.viewCase}<span class="sr-only">: {i.apuntafy.name}</span></a>
			<a class="text-link" href="https://apuntafy.com/es">apuntafy.com</a>
		</div>
	</article>

	<div class="project-pair">
		<article class="project">
			<div class="panel panel-tintely">
				<Image src={tintely1} alt={i.tintely.alt} widths={[300, 600]} sizes="(min-width: 760px) 22vw, 45vw" loading="lazy" />
				<Image src={tintely2} alt="" widths={[300, 600]} sizes="(min-width: 760px) 22vw, 45vw" loading="lazy" />
			</div>
			<div class="project-text">
				<h4>{i.tintely.name}</h4>
				<p>{i.tintely.text}</p>
				<p class="project-status">{i.tintely.status}</p>
				<p class="project-stack">{i.tintely.stack}</p>
				<a class="text-link" href="https://tintely.com">tintely.com</a>
			</div>
		</article>
		<article class="project">
			<div class="panel panel-zenlift">
				<Image src={zenlift1} alt={i.zenlift.alt} widths={[240, 400, 540]} sizes="(min-width: 760px) 13vw, 28vw" loading="lazy" />
				<Image src={zenlift2} alt="" widths={[240, 400, 540]} sizes="(min-width: 760px) 13vw, 28vw" loading="lazy" />
				<Image src={zenlift3} alt="" widths={[240, 400, 540]} sizes="(min-width: 760px) 13vw, 28vw" loading="lazy" />
			</div>
			<div class="project-text">
				<h4>{i.zenlift.name}</h4>
				<p>{i.zenlift.text}</p>
				<p class="project-status">{i.zenlift.status}</p>
				<p class="project-stack">{i.zenlift.stack}</p>
				<a class="text-link" href="https://zenlift.app">zenlift.app</a>
			</div>
		</article>
	</div>

	<div class="project-rows">
		<article class="project-text">
			<h4>{i.peoplecor.name}</h4>
			<p>{i.peoplecor.text}</p>
			<p class="project-status">{i.peoplecor.status}</p>
			<p class="project-stack">{i.peoplecor.stack}</p>
			<a class="text-link" href="https://peoplecor.com">peoplecor.com</a>
		</article>
		<article class="project-text">
			<h4>{i.turnimo.name}</h4>
			<p>{i.turnimo.text}</p>
			<p class="project-status">{i.turnimo.status}</p>
			<p class="project-stack">{i.turnimo.stack}</p>
		</article>
	</div>
</section>
