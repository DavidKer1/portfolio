---
import { Image } from "astro:assets";
import folioImg from "../assets/work/folio-pedido.png";
import { comparacion, prompts, type Pedido } from "../data/folio";
import { copy, type Lang } from "../i18n";
import CaseLayout from "./CaseLayout.astro";
import ScoreTable from "./ScoreTable.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const all = copy(lang);
const t = all.folioCase;
const r = t.route;
const paradas = [
	{ x: 60, label: r.mail },
	{ x: 280, label: r.model, modelo: true },
	{ x: 500, label: r.validator },
	{ x: 720, label: r.review },
	{ x: 930, label: r.export },
];
const verticales = [
	{ y: 30, label: r.mail },
	{ y: 100, label: r.model, modelo: true },
	{ y: 170, label: r.validator, nota: r.reject },
	{ y: 260, label: r.review },
	{ y: 330, label: r.export },
];
const tresLineas = `model, tokenizer = load(MODEL)
prompt = tokenizer.apply_chat_template([...], tokenize=False, add_generation_prompt=True, reasoning_effort="low")
result = generate(model, tokenizer, prompt=prompt, max_tokens=1000, verbose=False)`;

function salida(resultado: Pedido | null) {
	return resultado ? JSON.stringify(resultado, null, 2) : t.rejected;
}
const tipo = (original: string) => t.tipos[original] ?? original;
function inicio(correo: string) {
	const limpio = correo.replace(/\s+/g, " ").trim();
	return limpio.length > 74 ? `${limpio.slice(0, 74).trimEnd()}…` : limpio;
}
const otherPath = lang === "es" ? "/en/work/folio/" : "/trabajo/folio/";
---

<CaseLayout
	lang={lang}
	title={t.title}
	metaTitle={t.meta}
	description={t.description}
	lead={t.lead}
	facts={t.facts}
	otherPath={otherPath}
>
	<section class="case-section wrap case-two">
		<div>
			<h2>{t.routeTitle}</h2>
			<p>{t.routeText}</p>
		</div>
		<figure class="diagram panel panel-diagram" aria-label={`${r.mail}, ${r.model}, ${r.validator}, ${r.review}, ${r.export}. ${r.reject}.`}>
			<svg class="diagram-wide" viewBox="0 0 1000 190" role="img" aria-hidden="true">
				<path class="d-line" d="M60 70H930" />
				<path class="d-branch" d="M500 70V130Q500 150 520 150H560" />
				<text class="d-note" x="572" y="156">{r.reject}</text>
				{paradas.map((p) => (
					<g>
						<circle class:list={["d-node", { "is-model": p.modelo }]} cx={p.x} cy="70" r={p.modelo ? 11 : 8} />
						<text class:list={["d-label", { "is-model": p.modelo }]} x={p.x} y="38" text-anchor="middle">{p.label}</text>
					</g>
				))}
			</svg>
			<svg class="diagram-tall" viewBox="0 0 320 360" role="img" aria-hidden="true">
				<path class="d-line" d="M20 30V330" />
				{verticales.map((p) => (
					<g>
						<circle class:list={["d-node", { "is-model": p.modelo }]} cx="20" cy={p.y} r={p.modelo ? 10 : 7} />
						<text class:list={["d-label", { "is-model": p.modelo }]} x="46" y={p.y + 6}>{p.label}</text>
						{p.nota && <text class="d-note" x="46" y={p.y + 30}>{p.nota}</text>}
					</g>
				))}
			</svg>
		</figure>
	</section>

	<section class="case-section wrap">
		<figure class="case-shot">
			<Image src={folioImg} alt={all.work.items.folio.alt} widths={[640, 1000, 1400, 2000]} sizes="(min-width: 1500px) 1388px, 92vw" loading="lazy" />
			<figcaption>{t.shotCaption}</figcaption>
		</figure>
	</section>

	<section class="case-section wrap">
		<h2>{t.threeTitle}</h2>
		<p>{t.threeText}</p>
		<div class="case-code-block case-three">
			<p class="case-code-title">extract.py</p>
			<pre class="case-code" tabindex="0"><code>{tresLineas}</code></pre>
		</div>
	</section>

	<div class="band">
		<section class="case-section wrap" id={lang === "es" ? "evaluacion" : "evaluation"}>
			<h2>{all.evaluation.h2}</h2>
			<div class="case-prose">
				{all.evaluation.intro.map((p) => <p>{p}</p>)}
			</div>
			<div class="case-eval">
				<ScoreTable lang={lang} detailed />
			</div>
			<h3 class="case-subtitle">{t.promptsTitle}</h3>
			<div class="case-prompts">
				<div class="case-code-block">
					<p class="case-code-title">{t.promptOriginal}</p>
					<pre class="case-code case-wrap" lang="es" tabindex="0"><code>{prompts.original}</code></pre>
				</div>
				<div class="case-code-block">
					<p class="case-code-title">{t.promptFixed}</p>
					<pre class="case-code case-wrap" lang="es" tabindex="0"><code>{prompts.corregido}</code></pre>
				</div>
			</div>
		</section>
	</div>

	<section class="case-section wrap">
		<h2>{t.runsTitle}</h2>
		<p>{t.runsText}</p>
		<div class="runs-list">
			<div class="runs-table-head" aria-hidden="true">
				<span>{t.runsHeaders.case}</span>
				<span>{t.runsHeaders.type}</span>
				<span>{t.runsHeaders.original}</span>
				<span>{t.runsHeaders.fixed}</span>
			</div>
			<div class="runs-table">
				{comparacion.map((c) => (
					<details class="run-row">
						<summary>
							<span class="run-id" lang="es">{inicio(c.correo)}{t.sets[c.conjunto] && <span class="run-new" lang={lang}>{t.sets[c.conjunto]}</span>}</span>
							<span class="run-type">{tipo(c.tipo)}</span>
							<span class:list={c.original.correcto ? "run-ok" : "run-bad"}>{c.original.correcto ? t.ok : t.bad}</span>
							<span class:list={c.corregida.correcto ? "run-ok" : "run-bad"}>{c.corregida.correcto ? t.ok : t.bad}</span>
						</summary>
						<div class="run-detail">
							<div>
								<h4>{t.mail}</h4>
								<pre lang="es">{c.correo}</pre>
							</div>
							<div>
								<h4>{t.outOriginal} ({c.original.segundos} s)</h4>
								<pre lang="es">{salida(c.original.resultado)}</pre>
							</div>
							<div>
								<h4>{t.outFixed} ({c.corregida.segundos} s)</h4>
								<pre lang="es">{salida(c.corregida.resultado)}</pre>
							</div>
						</div>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="case-section wrap">
		<h2>{t.nextTitle}</h2>
		<p>{t.next}</p>
	</section>
</CaseLayout>
