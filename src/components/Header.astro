---
import { copy, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang);
const home = t.routes.home;
---

<header class="site-header">
	<nav class="nav-pill" aria-label={lang === "es" ? "Principal" : "Main"}>
		<a class="wordmark" href={home}>victorsanchez<span>.mx</span></a>
		<div class="nav-links">
			<a class="nav-optional" href={`${home}#${t.work.id}`}>{t.nav.work}</a>
			<a class="nav-optional" href={`${home}#${t.about.id}`}>{t.nav.about}</a>
			<a class="nav-lang" href={t.routes.other} hreflang={t.nav.otherLang} lang={t.nav.otherLang}>{t.nav.other}</a>
			<a class="btn btn-accent btn-pill" href={`${home}#${t.contact.id}`}>
				{t.nav.cta}
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
			</a>
		</div>
	</nav>
</header>
