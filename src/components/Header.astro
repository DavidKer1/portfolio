---
import { copy, escribeme, type Lang } from "../i18n";
import MailIcon from "./MailIcon.astro";

interface Props {
	lang: Lang;
	otherPath?: string;
}

const { lang, otherPath } = Astro.props;
const t = copy(lang);
const home = t.routes.home;
---

<header class="site-header">
	<div class="header-inner">
		<a class="logo" href={home}>Victor<span>Sanchez</span></a>
		<nav class="nav-pill" aria-label={lang === "es" ? "Principal" : "Main"}>
			<a href={`${home}#${t.services.id}`}>{t.nav.services}</a>
			<a href={`${home}#${t.work.id}`}>{t.nav.work}</a>
			<a href={`${home}#${t.process.id}`}>{t.nav.process}</a>
			<a href={`${home}#${t.about.id}`}>{t.nav.about}</a>
		</nav>
		<div class="header-actions">
			<a class="lang-btn" href={otherPath ?? t.routes.other} hreflang={t.nav.otherLang} lang={t.nav.otherLang} aria-label={t.nav.other}>{t.nav.otherShort}</a>
			<a class="btn btn-cream" href={escribeme(t.mensaje)}>
				{t.nav.cta}
				<MailIcon />
			</a>
		</div>
	</div>
</header>
