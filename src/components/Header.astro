---
import { copy, type Lang, whatsapp } from "../i18n";

interface Props {
	lang: Lang;
	otherPath?: string;
}

const { lang, otherPath } = Astro.props;
const t = copy(lang);
const home = t.routes.home;
---

<header class="site-header wrap">
	<a class="site-name" href={home}>Victor Sanchez</a>
	<nav aria-label={lang === "es" ? "Principal" : "Main"}>
		<a class="nav-optional" href={`${home}#${t.services.id}`}>{t.nav.services}</a>
		<a class="nav-optional" href={`${home}#${t.work.id}`}>{t.nav.work}</a>
		<a class="nav-optional" href={`${home}#${t.process.id}`}>{t.nav.process}</a>
		<a href={otherPath ?? t.routes.other} hreflang={t.nav.otherLang} lang={t.nav.otherLang}>{t.nav.other}</a>
		<a class="button button-small" href={whatsapp(lang)}>{t.nav.cta}</a>
	</nav>
</header>
