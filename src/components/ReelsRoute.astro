---
import { copy, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const r = copy(lang).reelsCase.route;
const paradas = [
	{ x: 50, label: r.prompt },
	{ x: 200, label: r.model, modelo: true },
	{ x: 350, label: r.plan },
	{ x: 500, label: r.workspace },
	{ x: 650, label: r.sandbox },
	{ x: 800, label: r.studio },
	{ x: 950, label: r.zip },
];
const verticales = [
	{ y: 30, label: r.prompt },
	{ y: 110, label: r.model, modelo: true },
	{ y: 190, label: r.plan, nota: r.fallback, detalle: r.fallbackNote },
	{ y: 300, label: r.workspace },
	{ y: 380, label: r.sandbox, nota: r.repair, detalle: r.repairNote },
	{ y: 490, label: r.studio },
	{ y: 570, label: r.zip },
];
---

<figure class="diagram" aria-label={`${r.prompt}, ${r.model}, ${r.plan}, ${r.workspace}, ${r.sandbox}, ${r.studio}, ${r.zip}. ${r.repair}, ${r.repairNote}. ${r.fallback}, ${r.fallbackNote}.`}>
	<svg class="diagram-wide" viewBox="0 0 1000 312" role="img" aria-hidden="true">
		<path class="d-line" d="M50 76H950" />
		<path class="d-loop" d="M650 76V206Q650 226 630 226H220Q200 226 200 206V76" />
		<path class="d-branch" d="M350 76V102Q350 122 370 122H480Q500 122 500 102V76" />
		<text class="d-note" x="425" y="150" text-anchor="middle">{r.fallback}</text>
		<text class="d-note d-dim" x="425" y="174" text-anchor="middle">{r.fallbackNote}</text>
		<text class="d-note" x="425" y="256" text-anchor="middle">{r.repair}</text>
		<text class="d-note d-dim" x="425" y="280" text-anchor="middle">{r.repairNote}</text>
		{paradas.map((p) => (
			<g>
				<circle class:list={["d-node", { "is-model": p.modelo }]} cx={p.x} cy="76" r={p.modelo ? 11 : 8} />
				<text class:list={["d-label", { "is-model": p.modelo }]} x={p.x} y="44" text-anchor="middle">{p.label}</text>
			</g>
		))}
	</svg>
	<svg class="diagram-tall" viewBox="0 0 360 600" role="img" aria-hidden="true">
		<path class="d-line" d="M20 30V570" />
		{verticales.map((p) => (
			<g>
				<circle class:list={["d-node", { "is-model": p.modelo }]} cx="20" cy={p.y} r={p.modelo ? 10 : 7} />
				<text class:list={["d-label", { "is-model": p.modelo }]} x="46" y={p.y + 6}>{p.label}</text>
				{p.nota && <text class="d-note" x="46" y={p.y + 30}>{p.nota}</text>}
				{p.detalle && <text class="d-note d-dim" x="46" y={p.y + 52}>{p.detalle}</text>}
			</g>
		))}
	</svg>
</figure>
